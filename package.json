{
  "name": "arceus-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p --silent dev:vite dev:mock",
    "dev:vite": "vite",
    "dev:mock": "nitro dev",
    "dev:tauri": "tauri dev",
    "dev:android": "vite build --mode dev-android && pnpm --silent build:mock && run-p --silent mock:start android:start",
    "build": "run-p --silent build:vite build:mock",
    "build:vite": "vite build",
    "build:mock": "nitro build",
    "build:tauri": "tauri build",
    "build:android": "pnpm --silent build && cap sync android && android\\gradlew.bat -p android assembleDebug",
    "mock:start": "node .output/server/index.mjs",
    "android:start": "cap run android",
    "preview": "vite preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@iconify/vue": "^5.0.1",
    "axios": "^1.18.1",
    "element-plus": "^2.14.2",
    "h3": "2.0.1-rc.26",
    "nitro": "3.0.260610-beta",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ant-design": "^1.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.6.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
