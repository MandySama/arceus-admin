{
  "name": "arceus-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -s dev:web",
    "dev:web": "pnpm -s -F @arceus/web dev",
    "dev:tauri": "pnpm -s -F @arceus/tauri dev",
    "dev:capacitor": "pnpm -s -F @arceus/capacitor dev",
    "build": "pnpm -s build:web",
    "build:web": "pnpm -s -F @arceus/web build",
    "build:tauri": "pnpm -s -F @arceus/tauri build",
    "build:capacitor": "pnpm -s -F @arceus/capacitor build",
    "preview": "pnpm -s -F @arceus/web preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint apps/web --fix",
    "lint:eslint": "eslint apps/web --fix --cache",
    "format": "prettier --write --experimental-cli apps/web/src/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.6.0",
    "npm-run-all2": "catalog:",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
